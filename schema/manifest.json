{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hearo.barelybooting.com/schema/manifest.json",
  "title": "Hearo Catalog Manifest",
  "description": "Top-level catalog index served at /catalog/index.json and /.",
  "type": "object",
  "required": ["catalog_version", "service_name", "collections"],
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "track_count", "url"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "track_count": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "tonys_pick_of_the_week": {
      "type": ["object", "null"]
    },
    "featured_track": {
      "type": ["object", "null"]
    }
  }
}
